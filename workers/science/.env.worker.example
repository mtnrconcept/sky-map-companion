# Copiez ce fichier sous .env.worker.local avec le script PowerShell fourni.
# N'ajoutez jamais .env.worker.local dans Git.

# Utilisez l'URL du pooler Supabase en mode Session sur le port 5432.
# Le script configure ajoute automatiquement sslmode=require.
# Encodez les caractères spéciaux du mot de passe dans l'URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Cet identifiant doit rester stable entre deux redémarrages.
WORKER_ID=dartman-windows-01
PIPELINE_VERSION=science-v1
LEASE_SECONDS=300
POLL_SECONDS=2
MAX_DERIVATIVE_BYTES=524288000
MAX_MASTER_PIXELS=40000000
MAX_SCALE_DEGRADATION=2.5

# Limites locales prudentes. Ajustez-les selon la RAM et le processeur du PC.
WORKER_MEMORY_LIMIT=8g
WORKER_CPU_LIMIT=4.0
